{
  "name": "EFEKTA PST POW DUO V2",
  "manufacturer": "EfektaLab",
  "model": "EFEKTA_PST_POW_DUO_V2_LR",
  "manufacturerIds": [
    "EfektaLab"
  ],
  "modelIds": [
    "EFEKTA_PST_POW_DUO_V2_LR"
  ],
  "template": [
    "/_Battery/BatteryPercentageRemaining.json"
  ],
  "init": [
    {
      "zcl": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0201_Custom",
          "zclDataType": "UNSIGNED_16_BIT_INTEGER"
        },
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0275_Custom",
          "zclDataType": "BOOLEAN"
        },
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0205_Custom",
          "zclDataType": "BOOLEAN"
        },
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0216_Custom",
          "zclDataType": "BOOLEAN"
        },
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0236_Custom",
          "zclDataType": "SIGNED_8_BIT_INTEGER"
        },
        {
          "endpoint": 1,
          "cluster": "0403_PressureMeasurement",
          "attribute": "0210_Custom",
          "zclDataType": "SIGNED_16_BIT_INTEGER"
        },
        {
          "endpoint": 2,
          "cluster": "0403_PressureMeasurement",
          "attribute": "0210_Custom",
          "zclDataType": "SIGNED_16_BIT_INTEGER"
        },
        {
          "endpoint": 1,
          "cluster": "0402_TemperatureMeasurement",
          "attribute": "0210_Custom",
          "zclDataType": "SIGNED_16_BIT_INTEGER"
        },
        {
          "endpoint": 2,
          "cluster": "0402_TemperatureMeasurement",
          "attribute": "0210_Custom",
          "zclDataType": "SIGNED_16_BIT_INTEGER"
        }
      ]
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "000A_Time",
          "attribute": "0007_LocalTime"
        }
      ],
      "bind": false,
      "report": false
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0000_MainsVoltage"
        }
      ],
      "bind": true,
      "report": false
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0021_BatteryPercentageRemaining"
        }
      ],
      "bind": true,
      "report": {
        "min": 1800,
        "max": 43200,
        "change": 1
      }
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "003E_BatteryAlarmState"
        }
      ],
      "bind": true,
      "report": {
        "min": 1800,
        "max": 43200,
        "change": 1
      }
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0403_PressureMeasurement",
          "attribute": "0000_MeasuredValue"
        }
      ],
      "bind": true,
      "report": {
        "min": 10,
        "max": 600,
        "change": 1
      }
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0402_TemperatureMeasurement",
          "attribute": "0000_MeasuredValue"
        }
      ],
      "bind": true,
      "report": {
        "min": 20,
        "max": 900,
        "change": 15
      }
    },
    {
      "link": [
        {
          "endpoint": 2,
          "cluster": "0403_PressureMeasurement",
          "attribute": "0000_MeasuredValue"
        }
      ],
      "bind": true,
      "report": {
        "min": 10,
        "max": 600,
        "change": 1
      }
    },
    {
      "link": [
        {
          "endpoint": 2,
          "cluster": "0402_TemperatureMeasurement",
          "attribute": "0000_MeasuredValue"
        }
      ],
      "bind": true,
      "report": {
        "min": 20,
        "max": 900,
        "change": 15
      }
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0403_PressureMeasurement",
          "output": true
        }
      ],
      "name": "Прямая передача данных давления газа/жидкости на другое устройство",
      "description": "Привязка к другому устройству по данным давления газа/жидкости, для прямой передачи данных на другое устройство.",
      "type": "String",
      "visibleBind": true
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0402_TemperatureMeasurement",
          "output": true
        }
      ],
      "name": "Прямая передача данных температуры на другое устройство",
      "description": "Привязка к другому устройству по данным температуры, для прямой передачи данных на другое устройство.",
      "type": "String",
      "visibleBind": true
    },
    {
      "link": [
        {
          "endpoint": 2,
          "cluster": "0403_PressureMeasurement",
          "output": true
        }
      ],
      "name": "Прямая передача данных давления газа/жидкости на другое устройство",
      "description": "Привязка к другому устройству по данным давления газа/жидкости, для прямой передачи данных на другое устройство.",
      "type": "String",
      "visibleBind": true
    },
    {
      "link": [
        {
          "endpoint": 2,
          "cluster": "0402_TemperatureMeasurement",
          "output": true
        }
      ],
      "name": "Прямая передача данных температуры на другое устройство",
      "description": "Привязка к другому устройству по данным температуры, для прямой передачи данных на другое устройство.",
      "type": "String",
      "visibleBind": true
    }
  ],
  "services": [
    {
      "name": "Датчик давления 1",
      "type": "C_AtmosphericPressureSensor",
      "characteristics": [
        {
          "type": "C_CurrentAtmosphericPressure",
          "unit": "Bar",
          "minStep": 0.01,
          "maxValue": 10,
          "link": [
            {
              "type": "Double",
              "endpoint": 1,
              "cluster": "0403_PressureMeasurement",
              "attribute": "0000_MeasuredValue",
              "inFunc": "value*0.001333"
            }
          ]
        }
      ]
    },
    {
      "name": "Датчик температуры 1",
      "type": "TemperatureSensor",
      "characteristics": [
        {
          "type": "CurrentTemperature",
          "link": [
            {
              "endpoint": 1,
              "cluster": "0402_TemperatureMeasurement",
              "attribute": "0000_MeasuredValue"
            }
          ]
        }
      ]
    },
    {
      "name": "Датчик давления 2",
      "type": "C_AtmosphericPressureSensor",
      "characteristics": [
        {
          "type": "C_CurrentAtmosphericPressure",
          "unit": "Bar",
          "minStep": 0.01,
          "maxValue": 10,
          "link": [
            {
              "type": "Double",
              "endpoint": 2,
              "cluster": "0403_PressureMeasurement",
              "attribute": "0000_MeasuredValue",
              "inFunc": "value*0.001333"
            }
          ]
        }
      ]
    },
    {
      "name": "Датчик температуры 2",
      "type": "TemperatureSensor",
      "characteristics": [
        {
          "type": "CurrentTemperature",
          "link": [
            {
              "endpoint": 2,
              "cluster": "0402_TemperatureMeasurement",
              "attribute": "0000_MeasuredValue"
            }
          ]
        }
      ]
    },
    {
      "name": "Mains voltage",
      "type": "C_VoltMeter",
      "characteristics": [
        {
          "type": "C_Volt",
          "link": [
            {
              "endpoint": 1,
              "cluster": "0001_PowerConfiguration",
              "attribute": "0000_MainsVoltage",
              "inFunc": "value*0.1"
            }
          ]
        }
      ]
    }
  ],
  "options": [
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "000A_Time",
          "attribute": "0007_LocalTime"
        }
      ],
      "name": "Время работы устройства",
      "type": "Integer",
      "unit": "ч.",
      "write": false,
      "value": 0,
      "inputType": "STATUS"
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0201_Custom"
        }
      ],
      "name": "Интервал чтения сенсоров, в секундах",
      "type": "Integer",
      "unit": "сек.",
      "value": 20,
      "minValue": 3,
      "maxValue": 3600,
      "minStep": 1
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0236_Custom"
        }
      ],
      "name": "Мощность радиопередатчика",
      "description": "Чем выше мощность, тем выше энергопотребление, на максимальной мощности в 19dBm, потребление составляет 100mA при передаче, а при мощности 4dBm – 50mA",
      "type": "Integer",
      "value": 19,
      "values": [
        {
          "value": 4,
          "name": "4dBm"
        },
        {
          "value": 19,
          "name": "19dBm"
        }
      ]
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0216_Custom"
        }
      ],
      "name": "Режим работы датчика с опросом (умный сон)",
      "description": "Пробуждение датчика раз в 2-7 секунд для приёма данных от хаба, в данном режиме увеличивается энергопотребление",
      "type": "Boolean",
      "value": true
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0275_Custom"
        }
      ],
      "name": "Режим работы датчика по сконфигурированным отчетам",
      "description": "Отправка данных происходит в соответствии с настройками в разделе Уведомления",
      "type": "Boolean",
      "value": true
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0001_PowerConfiguration",
          "attribute": "0205_Custom"
        }
      ],
      "name": "Сравнение данных с предыдущими, работы датчика в режиме по таймеру",
      "description": "Игнорирует настройки в разделе Уведомления и отправляет данные по пробуждению, сравнивая их с предыдущими, по порогам заданным в ПО (температура 0.25°C, давление 1hPa)",
      "type": "Boolean",
      "value": false
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0403_PressureMeasurement",
          "attribute": "0210_Custom"
        }
      ],
      "name": "Корректировка давления первого сенсора",
      "type": "Integer",
      "unit": "hPa",
      "value": 0,
      "minValue": -1000,
      "maxValue": 1000,
      "minStep": 1
    },
    {
      "link": [
        {
          "endpoint": 1,
          "cluster": "0402_TemperatureMeasurement",
          "attribute": "0210_Custom"
        }
      ],
      "name": "Корректировка температуры в первом сенсоре",
      "description": "Единица равна корректировке в 0.1°C.",
      "unit": "°C",
      "type": "Integer",
      "value": 1,
      "minValue": -250,
      "maxValue": 250
    },
    {
      "link": [
        {
          "endpoint": 2,
          "cluster": "0403_PressureMeasurement",
          "attribute": "0210_Custom"
        }
      ],
      "name": "Корректировка давления второго сенсора",
      "type": "Integer",
      "unit": "hPa",
      "value": 0,
      "minValue": -100,
      "maxValue": 100,
      "minStep": 1
    },
    {
      "link": [
        {
          "endpoint": 2,
          "cluster": "0402_TemperatureMeasurement",
          "attribute": "0210_Custom"
        }
      ],
      "name": "Корректировка температуры во втором сенсоре",
      "description": "Единица равна корректировке в 0.1°C.",
      "unit": "°C",
      "type": "Integer",
      "value": 1,
      "minValue": -250,
      "maxValue": 250
    }
  ]
}